+void BodyModel::applyBoneRotations(const int16_t boneRotations[25][3])
+{
+    if (!mUseSkeleton)
+        return;
+
+    // Re-initialize local matrices from the rest pose.
+    const s32 boneCount = mpBodyModel->mBoneCount;
+    s32 parentBoneIDs[sizeof(mSkeletonMatrix) / sizeof(rio::Matrix34f)];
+    for (s32 i = 0; i < boneCount; i++)
+    {
+        mSkeletonMatrix[i] = mpBodyModel->mBones[i].localMatrix;
+        parentBoneIDs[i]   = mpBodyModel->mBones[i].parentID;
+    }
+
+    // Apply user-specified rotation overrides.
+    const s32 maxBone = (boneCount < (s32)VriableIconBodyBoneKind_End)
+                        ? boneCount : (s32)VriableIconBodyBoneKind_End;
+    for (s32 bone = 0; bone < maxBone; bone++)
+    {
+        if (boneRotations[bone][0] == 0 &&
+            boneRotations[bone][1] == 0 &&
+            boneRotations[bone][2] == 0)
+            continue; // no override for this bone
+
+        // Convert fixed-point (degrees*10) to radians.
+        constexpr f32 kDegTenToRad = M_PI / 1800.0f;
+        const f32 rx = boneRotations[bone][0] * kDegTenToRad;
+        const f32 ry = boneRotations[bone][1] * kDegTenToRad;
+        const f32 rz = boneRotations[bone][2] * kDegTenToRad;
+
+        // ZYX Euler order (game-rigging convention): compose Rx * Ry * Rz.
+        rio::Matrix34f rotX, rotY, rotZ, rotMtx;
+        rotX.makeR({ rx, 0.0f, 0.0f });
+        rotY.makeR({ 0.0f, ry, 0.0f });
+        rotZ.makeR({ 0.0f, 0.0f, rz });
+        rotMtx.setMul(rotX, rotY);
+        rotMtx.setMul(rotMtx, rotZ);
+
+        // Rotate in-place: preserve local translation, apply rotation to orientation.
+        const rio::Vector3f trans = GetMatrixTranslation(mSkeletonMatrix[bone]);
+        mSkeletonMatrix[bone].setMul(rotMtx, mSkeletonMatrix[bone]);
+        SetMatrixTranslation(mSkeletonMatrix[bone], trans);
+    }
+
+    // Recalculate world matrices with the modified local poses.
+    calculateWorldMatrix_(mSkeletonMatrix, parentBoneIDs, boneCount, mBodyScale);
+}
